{
  "name": "ek-inventry-backend",
  "version": "1.0.0",
  "description": "Serverless AWS Lambda API for EK GearFlow",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node test-runner.js",
    "test:all": "node test-runner.js",
    "test:rbac": "node test-auth-rbac.js",
    "test:comprehensive": "node test-comprehensive.js",
    "predeploy": "npm test",
    "predeploy:backend": "npm test",
    "predeploy:frontend": "npm test",
    "deploy:backend": "serverless deploy --stage prod",
    "deploy:frontend": "node deploy-frontend.js --stage prod",
    "deploy": "serverless deploy --stage prod && node deploy-frontend.js --stage prod",
    "seed:prod": "node seed-dynamodb.js --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1135.0",
    "@aws-sdk/client-cloudfront": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "serverless": "^3.38.0"
  }
}
